generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  OWNER
  MANAGER
  OPERATOR
  MAINTENANCE
  HOUSEKEEPING
  VIEWER
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  ONBOARDING
}

enum UnitCategory {
  GRAND_SUITE
  DELUXE
  STANDARD
  APARTMENT
  HOUSE
  TABLE
  CUSTOM
}

enum ReservationSource {
  DIRECT
  AIRBNB
  BOOKING
  EXPEDIA
  WHATSAPP
  PHONE
  MANUAL
  OTHER
}

enum ReservationStatus {
  INQUIRY
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum SyncStatus {
  SYNCED
  PENDING
  FAILED
  NOT_APPLICABLE
}

enum ConversationChannel {
  WHATSAPP
  VOICE
  EMAIL
  WEBCHAT
  PMS
  INTERNAL
}

enum ConversationStatus {
  OPEN
  PENDING_HUMAN
  PENDING_APPROVAL
  ESCALATED
  CLOSED
}

enum SenderType {
  GUEST
  AGENT
  USER
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  SYSTEM_EVENT
}

enum ServiceCategory {
  SPA
  TRANSPORT
  ROOM_SERVICE
  TOUR
  LATE_CHECKOUT
  EARLY_CHECKIN
  CLEANING
  FOOD
  OTHER
}

enum ServiceBookingStatus {
  REQUESTED
  PENDING_APPROVAL
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  HVAC
  WIFI
  APPLIANCE
  LOCK
  CLEANING
  SAFETY
  AESTHETIC
  OTHER
}

enum MaintenanceUrgency {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum MaintenanceStatus {
  OPEN
  TRIAGED
  QUOTE_REQUESTED
  SCHEDULED
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum MaintenanceSource {
  GUEST_REPORT
  STAFF_REPORT
  INSPECTION
  AI_DETECTED
  OTHER
}

enum QuoteStatus {
  REQUESTED
  SUBMITTED
  APPROVED
  REJECTED
  EXPIRED
}

enum HousekeepingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  VERIFIED
  ISSUE_FOUND
}

enum KnowledgeSourceType {
  MANUAL_ENTRY
  UPLOAD
  IMPORT
  AI_SUGGESTED
}

enum ResourceType {
  IMAGE
  VIDEO
  PDF
  LINK
  AUDIO
  TEXT
}

enum GapStatus {
  OPEN
  PROPOSED
  APPROVED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  EXECUTED
  FAILED
}

enum RiskLevel {
  LEVEL_0
  LEVEL_1
  LEVEL_2
  LEVEL_3
}

enum ActorType {
  HUMAN
  AGENT
  SYSTEM
}

enum ContentIdeaStatus {
  IDEA
  DRAFTED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// ============================================================
// CORE / TENANCY
// ============================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("America/Santiago")
  locale    String   @default("es-CL")
  currency  String   @default("CLP")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  properties          Property[]
  guests              Guest[]
  reservations        Reservation[]
  maintenanceTickets  MaintenanceTicket[]
  contractors         Contractor[]
  knowledgeDocuments  KnowledgeDocument[]
  competitors         Competitor[]
  marketEvents        MarketEvent[]
  brandProfiles       BrandProfile[]
  approvalRequests    ApprovalRequest[]
  dailyMetrics        DailyMetric[]
  trainingPrograms    TrainingProgram[]
  conversations       Conversation[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  role           UserRole @default(OPERATOR)
  organizationId String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[]       @relation("AssignedUser")
  housekeepingTasks    HousekeepingTask[]
  trainingProgress     TrainingProgress[]
  approvalsRequested   ApprovalRequest[]     @relation("ApprovalRequestedBy")

  @@index([organizationId])
}

// ============================================================
// PROPERTIES / UNITS
// ============================================================

model Property {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  internalCode   String
  propertyType   String         @default("HOTEL")
  description    String?
  address        String?
  city           String?
  country        String?
  timezone       String         @default("America/Santiago")
  locale         String         @default("es-CL")
  currency       String         @default("CLP")
  checkInTime    String         @default("15:00")
  checkOutTime   String         @default("11:00")
  whatsappNumber String?        @unique
  maximumGuests  Int            @default(2)
  bedrooms       Int            @default(1)
  bathrooms      Int            @default(1)
  status         PropertyStatus @default(ACTIVE)
  active         Boolean        @default(true)
  // Restaurant-specific service windows (only meaningful when propertyType = "RESTAURANT").
  // Left null for hotel/vacation-rental properties, which use checkInTime/checkOutTime instead.
  lunchOpen                  String?  // "HH:MM", e.g. "12:30"
  lunchClose                 String?  // "HH:MM", e.g. "16:00"
  dinnerOpen                 String?  // "HH:MM", e.g. "19:30"
  dinnerClose                String?  // "HH:MM", e.g. "23:30"
  closedWeekdays              Json    @default("[]") // JS getDay(): 0=Sunday..6=Saturday
  reservationDurationMinutes Int      @default(120) // default table-booking length
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  units                Unit[]
  reservations         Reservation[]
  conversations        Conversation[]
  services             Service[]
  maintenanceTickets   MaintenanceTicket[]
  housekeepingTasks    HousekeepingTask[]
  inventoryItems       InventoryItem[]
  knowledgeDocuments   KnowledgeDocument[]
  competitors          Competitor[]
  brandProfiles        BrandProfile[]
  contentIdeas         ContentIdea[]
  dailyMetrics         DailyMetric[]
  visualAnalyses       VisualAnalysis[]
  knowledgeGaps        KnowledgeGap[]

  @@unique([organizationId, internalCode])
  @@index([organizationId])
}

model Unit {
  id            String       @id @default(cuid())
  propertyId    String
  name          String
  code          String
  category      UnitCategory @default(STANDARD)
  description   String?
  maximumGuests Int          @default(2)
  basePrice     Decimal      @db.Decimal(12, 2)
  cleaningFee   Decimal      @default(0) @db.Decimal(12, 2)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  property             Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  secrets              UnitSecret[]
  reservations         Reservation[]
  availabilityBlocks   AvailabilityBlock[]
  conversations        Conversation[]
  maintenanceTickets   MaintenanceTicket[]
  housekeepingTasks    HousekeepingTask[]
  knowledgeDocuments   KnowledgeDocument[]

  @@unique([propertyId, code])
  @@index([propertyId])
}

model UnitSecret {
  id              String    @id @default(cuid())
  unitId          String
  secretType      String
  encryptedValue  String
  visibleFrom     DateTime?
  visibleUntil    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
}

// ============================================================
// GUESTS / RESERVATIONS
// ============================================================

model Guest {
  id                 String   @id @default(cuid())
  organizationId     String
  firstName          String
  lastName           String?
  phone              String?
  email              String?
  preferredLanguage  String   @default("es")
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservations  Reservation[]
  conversations Conversation[]
  serviceBookings ServiceBooking[]
  maintenanceTickets MaintenanceTicket[]

  @@index([organizationId])
  @@index([organizationId, phone])
}

model Reservation {
  id             String            @id @default(cuid())
  organizationId String
  propertyId     String
  unitId         String
  guestId        String
  externalId     String?
  source         ReservationSource @default(DIRECT)
  status         ReservationStatus @default(INQUIRY)
  checkIn        DateTime
  checkOut       DateTime
  adults         Int               @default(1)
  children       Int               @default(0)
  totalGuests    Int               @default(1)
  subtotal       Decimal           @default(0) @db.Decimal(12, 2)
  taxes          Decimal           @default(0) @db.Decimal(12, 2)
  fees           Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal           @default(0) @db.Decimal(12, 2)
  amountPaid     Decimal           @default(0) @db.Decimal(12, 2)
  currency       String            @default("CLP")
  specialRequests String?
  internalNotes  String?
  paymentUrl     String?
  calendarEventId String?
  syncStatus     SyncStatus        @default(NOT_APPLICABLE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit          Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  guest         Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)

  conversations      Conversation[]
  serviceBookings     ServiceBooking[]
  maintenanceTickets  MaintenanceTicket[]
  housekeepingTasks   HousekeepingTask[]

  @@index([organizationId, propertyId])
  @@index([unitId, checkIn, checkOut])
  @@index([guestId])
}

model AvailabilityBlock {
  id         String   @id @default(cuid())
  unitId     String
  startAt    DateTime
  endAt      DateTime
  reason     String
  externalId String?
  createdAt  DateTime @default(now())

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, startAt, endAt])
}

// ============================================================
// CONVERSATIONS / MESSAGES
// ============================================================

model Conversation {
  id              String              @id @default(cuid())
  organizationId  String
  propertyId      String
  unitId          String?
  guestId         String?
  reservationId   String?
  channel         ConversationChannel @default(WHATSAPP)
  externalThreadId String?
  status          ConversationStatus  @default(OPEN)
  assignedAgent   String?
  assignedUserId  String?
  language        String              @default("es")
  sentiment       String?
  urgency         String?
  lastMessageAt   DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit         Unit?        @relation(fields: [unitId], references: [id])
  guest        Guest?       @relation(fields: [guestId], references: [id])
  reservation  Reservation? @relation(fields: [reservationId], references: [id])
  assignedUser User?        @relation("AssignedUser", fields: [assignedUserId], references: [id])

  messages          Message[]
  agentExecutions   AgentExecution[]
  knowledgeGaps     KnowledgeGap[]

  @@index([organizationId, propertyId])
  @@index([status])
}

model Message {
  id               String      @id @default(cuid())
  conversationId   String
  senderType       SenderType
  senderId         String?
  content          String
  messageType      MessageType @default(TEXT)
  metadata         Json        @default("{}")
  aiGenerated      Boolean     @default(false)
  requiresApproval Boolean     @default(false)
  createdAt        DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ============================================================
// SERVICES
// ============================================================

model Service {
  id               String          @id @default(cuid())
  propertyId       String
  name             String
  category         ServiceCategory @default(OTHER)
  description      String?
  price            Decimal         @db.Decimal(12, 2)
  currency         String          @default("CLP")
  capacity         Int?
  durationMinutes  Int?
  active           Boolean         @default(true)
  requiresApproval Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  property Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookings ServiceBooking[]

  @@index([propertyId])
}

model ServiceBooking {
  id               String                @id @default(cuid())
  serviceId        String
  reservationId    String?
  guestId          String
  scheduledAt      DateTime
  quantity         Int                   @default(1)
  totalAmount      Decimal               @db.Decimal(12, 2)
  status           ServiceBookingStatus  @default(REQUESTED)
  notes            String?
  approvalRequestId String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  service     Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id])
  guest       Guest        @relation(fields: [guestId], references: [id])

  @@index([serviceId])
  @@index([guestId])
}

// ============================================================
// MAINTENANCE
// ============================================================

model MaintenanceTicket {
  id                     String              @id @default(cuid())
  organizationId         String
  propertyId             String
  unitId                 String
  reservationId          String?
  guestId                String?
  title                  String
  description            String
  category               MaintenanceCategory @default(OTHER)
  urgency                MaintenanceUrgency  @default(MEDIUM)
  status                 MaintenanceStatus   @default(OPEN)
  source                 MaintenanceSource   @default(GUEST_REPORT)
  troubleshootingAttempted Boolean           @default(false)
  guestEntryAuthorized   Boolean             @default(false)
  assignedContractorId   String?
  estimatedCost          Decimal?            @db.Decimal(12, 2)
  finalCost              Decimal?            @db.Decimal(12, 2)
  resolvedAt             DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  reservation  Reservation? @relation(fields: [reservationId], references: [id])
  guest        Guest?       @relation(fields: [guestId], references: [id])
  contractor   Contractor?  @relation(fields: [assignedContractorId], references: [id])

  quotes ContractorQuote[]

  @@index([organizationId, propertyId])
  @@index([status, urgency])
}

model Contractor {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  company        String?
  phone          String?
  email          String?
  regions        Json     @default("[]")
  specialties    Json     @default("[]")
  hourlyRate     Decimal? @db.Decimal(12, 2)
  rating         Float?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets      MaintenanceTicket[]
  quotes       ContractorQuote[]

  @@index([organizationId])
}

model ContractorQuote {
  id                  String      @id @default(cuid())
  maintenanceTicketId String
  contractorId        String
  amount              Decimal     @db.Decimal(12, 2)
  currency            String      @default("CLP")
  availableAt         DateTime?
  notes               String?
  status              QuoteStatus @default(REQUESTED)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  ticket     MaintenanceTicket @relation(fields: [maintenanceTicketId], references: [id], onDelete: Cascade)
  contractor Contractor        @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([maintenanceTicketId])
}

// ============================================================
// HOUSEKEEPING / INVENTORY
// ============================================================

model HousekeepingTask {
  id             String             @id @default(cuid())
  propertyId     String
  unitId         String
  reservationId  String?
  assignedUserId String?
  scheduledAt    DateTime
  status         HousekeepingStatus @default(PENDING)
  checklist      Json               @default("[]")
  issues         Json               @default("[]")
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  reservation  Reservation? @relation(fields: [reservationId], references: [id])
  assignedUser User?        @relation(fields: [assignedUserId], references: [id])

  @@index([propertyId, scheduledAt])
}

model InventoryItem {
  id               String   @id @default(cuid())
  propertyId       String
  name             String
  category         String
  currentQuantity  Int      @default(0)
  minimumQuantity  Int      @default(0)
  unitOfMeasure    String   @default("unidad")
  supplier         String?
  updatedAt        DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

// ============================================================
// KNOWLEDGE
// ============================================================

model KnowledgeDocument {
  id             String              @id @default(cuid())
  organizationId String
  propertyId     String?
  unitId         String?
  title          String
  category       String
  content        String
  sourceType     KnowledgeSourceType @default(MANUAL_ENTRY)
  sourceUrl      String?
  version        Int                 @default(1)
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property?           @relation(fields: [propertyId], references: [id])
  unit         Unit?               @relation(fields: [unitId], references: [id])
  resources    KnowledgeResource[]

  @@index([organizationId, propertyId])
}

model KnowledgeResource {
  id           String       @id @default(cuid())
  documentId   String
  resourceType ResourceType @default(LINK)
  title        String
  url          String?
  localPath    String?
  description  String?
  tags         Json         @default("[]")
  createdAt    DateTime     @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model KnowledgeGap {
  id                  String    @id @default(cuid())
  propertyId          String
  conversationId       String
  question            String
  missingInformation  String
  proposedAnswer      String?
  status              GapStatus @default(OPEN)
  approvedBy          String?
  approvedAt          DateTime?
  createdAt           DateTime  @default(now())

  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
}

// ============================================================
// COMPETITIVE INTELLIGENCE / MARKETING
// ============================================================

model Competitor {
  id                String   @id @default(cuid())
  organizationId    String
  propertyId        String
  name              String
  listingUrl        String?
  platform          String?
  location          String?
  targetGuestProfile String?
  threatScore       Float    @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  snapshots    CompetitorSnapshot[]
  reviews      CompetitorReview[]
  visualAnalyses VisualAnalysis[]

  @@index([organizationId, propertyId])
}

model CompetitorSnapshot {
  id            String   @id @default(cuid())
  competitorId  String
  capturedAt    DateTime @default(now())
  title         String?
  description   String?
  nightlyPrice  Decimal? @db.Decimal(12, 2)
  rating        Float?
  reviewCount   Int?
  amenities     Json     @default("[]")
  heroImageUrl  String?
  rawData       Json     @default("{}")

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, capturedAt])
}

model CompetitorReview {
  id                  String   @id @default(cuid())
  competitorId        String
  rating              Float
  reviewText          String
  reviewDate          DateTime?
  sentiment           String?
  extractedAmenities  Json     @default("[]")
  extractedPainPoints Json     @default("[]")
  createdAt           DateTime @default(now())

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId])
}

model VisualAnalysis {
  id                    String   @id @default(cuid())
  propertyId            String?
  competitorId          String?
  imageUrl              String
  analysis              Json     @default("{}")
  brightnessScore       Float?
  emotionalImpactScore  Float?
  compositionScore      Float?
  recommendations       Json     @default("[]")
  createdAt             DateTime @default(now())

  property   Property?   @relation(fields: [propertyId], references: [id])
  competitor Competitor? @relation(fields: [competitorId], references: [id])

  @@index([propertyId])
  @@index([competitorId])
}

model MarketEvent {
  id             String   @id @default(cuid())
  organizationId String
  location       String
  name           String
  startAt        DateTime
  endAt          DateTime
  source         String?
  demandImpact   String?
  confidence     Float?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startAt])
}

model BrandProfile {
  id                 String   @id @default(cuid())
  organizationId     String
  propertyId         String?
  // Per-organization AI persona name shown to guests in conversation (e.g. "Valentina").
  // This is the configurable feature-level persona name -- distinct from "Nexvore", which is
  // the platform brand shown in the dashboard and is never guest-facing.
  assistantName      String?
  targetAudience     String?
  tone               String?
  valueProposition   String?
  differentiators    Json     @default("[]")
  visualStyle        Json     @default("{}")
  prohibitedClaims   Json     @default("[]")
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property?    @relation(fields: [propertyId], references: [id])

  @@index([organizationId])
}

model ContentIdea {
  id             String            @id @default(cuid())
  propertyId     String
  title          String
  hook           String?
  format         String?
  platform       String?
  script         String?
  status         ContentIdeaStatus @default(IDEA)
  sourceInsight  String?
  scheduledAt    DateTime?
  createdAt      DateTime          @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
}

// ============================================================
// APPROVALS / AUDIT / EXECUTIONS / METRICS
// ============================================================

model ApprovalRequest {
  id                String          @id @default(cuid())
  organizationId    String
  requestedByAgent  String?
  requestedByUserId String?
  actionType        String
  riskLevel         RiskLevel
  entityType        String
  entityId          String?
  summary           String
  payload           Json            @default("{}")
  status            ApprovalStatus  @default(PENDING)
  approvedBy        String?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  expiresAt         DateTime?
  createdAt         DateTime        @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedByUser User?        @relation("ApprovalRequestedBy", fields: [requestedByUserId], references: [id])

  @@index([organizationId, status])
}

model AuditLog {
  id           String    @id @default(cuid())
  actorId      String?
  actorType    ActorType
  action       String
  entityType   String
  entityId     String?
  beforeData   Json?
  afterData    Json?
  reason       String?
  riskLevel    RiskLevel
  approvalStatus String?
  organizationId String?
  propertyId   String?
  success      Boolean   @default(true)
  error        String?
  createdAt    DateTime  @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

model AgentExecution {
  id             String   @id @default(cuid())
  agentName      String
  propertyId     String?
  conversationId String?
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  estimatedCost  Decimal  @default(0) @db.Decimal(12, 6)
  durationMs     Int      @default(0)
  toolsUsed      Json     @default("[]")
  success        Boolean  @default(true)
  error          String?
  createdAt      DateTime @default(now())

  conversation Conversation? @relation(fields: [conversationId], references: [id])

  @@index([agentName, createdAt])
  @@index([conversationId])
}

model DailyMetric {
  id                          String   @id @default(cuid())
  organizationId              String
  propertyId                  String?
  date                        DateTime
  conversationsHandled        Int      @default(0)
  reservationsCreated         Int      @default(0)
  ticketsCreated               Int      @default(0)
  humanEscalations            Int      @default(0)
  upsellRevenue                Decimal  @default(0) @db.Decimal(12, 2)
  estimatedHumanMinutesSaved  Int      @default(0)
  aiCost                      Decimal  @default(0) @db.Decimal(12, 4)
  createdAt                   DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property?    @relation(fields: [propertyId], references: [id])

  @@index([organizationId, date])
}

// ============================================================
// TRAINING / SKILLS
// ============================================================

model TrainingProgram {
  id                  String   @id @default(cuid())
  organizationId      String
  title               String
  knowledgeDocumentId String?
  passScore           Int      @default(80)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  progress     TrainingProgress[]

  @@index([organizationId])
}

model TrainingProgress {
  id            String    @id @default(cuid())
  programId     String
  userId        String
  currentModule Int       @default(0)
  score         Int?
  completed     Boolean   @default(false)
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  program TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([programId, userId])
}

model Skill {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String
  inputSchema    Json     @default("{}")
  agent          String
  tools          Json     @default("[]")
  promptTemplate String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
}
