NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3001

# --- Local / docker-compose / persistent-server dev ------------------------
# Used directly when set. This is what `docker-compose.yml` and the "Run it"
# section of the README point at.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hospitality_ai
REDIS_URL=redis://localhost:6379

# --- Vercel Postgres (Neon) --------------------------------------------
# Set automatically by Vercel when you attach a "Postgres" storage product to
# the project (Storage tab -> Postgres -> Connect Project) -- you do not set
# these by hand on Vercel, they just appear. Listed here so local `.env`
# users understand the fallback chain in config/env.ts: if DATABASE_URL is
# unset, it's derived from POSTGRES_PRISMA_URL, then POSTGRES_URL.
# POSTGRES_PRISMA_URL is the *pooled* (pgbouncer) connection string -- use
# this one (or let it be picked automatically) for the running app.
# POSTGRES_URL_NON_POOLING is the *direct* connection -- use this one only
# for `prisma migrate deploy` (pass it explicitly as DATABASE_URL for that
# one command; do not use it as the app's runtime DATABASE_URL).
# POSTGRES_PRISMA_URL=
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=

# --- Vercel KV (Upstash) -------------------------------------------------
# Set automatically by Vercel when you attach a "KV" storage product to the
# project (Storage tab -> KV -> Connect Project). KV_REST_API_URL/TOKEN (the
# HTTPS REST endpoint) is what apps/api/src/utils/redis.ts and
# middleware/rate-limit.ts actually use on Vercel via @upstash/redis --
# REDIS_URL/ioredis (above) cannot hold a TCP connection open from a
# serverless function. KV_URL is a redis:// TCP URL Vercel also injects; it
# is NOT reliably usable from a serverless function and is only picked up
# here as a REDIS_URL fallback for the persistent-server deployment path.
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=

# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`
# (Vercel does this automatically once this env var is set on the project) --
# checked by apps/api/src/routes/cron.routes.ts. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

JWT_SECRET=cambiar_por_un_secreto_largo
JWT_EXPIRES_IN=7d
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
VOICE_PROVIDER=mock
VAPI_API_KEY=
BLAND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/google/callback
SLACK_WEBHOOK_URL=
PMS_PROVIDER=mock
PMS_API_KEY=
PMS_BASE_URL=
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
MERCADOPAGO_ACCESS_TOKEN=
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
DEFAULT_TIMEZONE=America/Santiago
DEFAULT_LOCALE=es-CL
ENABLE_AUTOMATIC_LOW_RISK_ACTIONS=true
ENABLE_FINANCIAL_ACTIONS=false
ENABLE_DOOR_CODE_SHARING=false
UNIT_SECRET_ENCRYPTION_KEY=
